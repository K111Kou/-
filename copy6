#include <Servo.h>

/* 超音波センサー */
#define SERVOPIN  9
#define HC_ECHO   2
#define HC_TRIG   10

/* 赤外線センサー */
#define IRLED_L   4
#define IRLED_R   5

/* モーター */
#define RMO_EA    3
#define RMO_EB    6
#define RMO_MB1   7
#define RMO_MB2   8
#define RMO_MA2   11
#define RMO_MA1   12

Servo head;


/* ==================================================
   設定値
   ================================================== */

/* 通常走行 */
const int L_PWM = 140;
const int R_PWM = 140;

/* 方向修正 */
const int ADJUST_FAST_PWM = 140;
const int ADJUST_SLOW_PWM = 100;

/* 正面の壁を検知する距離 */
const float WALL_DISTANCE = 20.0;

/* ゴール */
const float GOAL_DISTANCE = 5.0;

/*
  左右を見たとき、
  この距離より遠ければ通路が開いていると考える
*/
const float SIDE_OPEN_DISTANCE = 35.0;

/*
  旋回後に正面がこの距離より開けば
  前にあった壁を抜けたと判断する
*/
const float REARM_DISTANCE = 25.0;


/* サーボ角度 */
const int FRONT_ANGLE = 90;
const int LEFT_ANGLE = 140;
const int RIGHT_ANGLE = 45;


/* 旋回時間 */
const int TURN_90_MS = 350;
const int TURN_180_MS = 1800;

/* 軽い方向修正 */
const int ADJUST_TIME = 150;

/*
  曲がった直後はIRによる補正を行わない
*/
const unsigned long IR_IGNORE_TIME = 400;


/* 赤外線センサー */
const int IR_ACTIVE = LOW;


/* ==================================================
   状態
   ================================================== */

enum CourseState {

  /* 行き 横方向 */
  OUTBOUND_HORIZONTAL,

  /* 行き 縦方向 */
  OUTBOUND_VERTICAL,

  /* 帰り 縦方向 */
  RETURN_VERTICAL,

  /* 帰り 横方向 */
  RETURN_HORIZONTAL,

  GOAL
};

CourseState state = OUTBOUND_HORIZONTAL;


/*
  状態が変更された時間
*/
unsigned long stateStartTime = 0;


/*
  次の壁を検出してよいか

  falseの場合は、
  旋回前の壁をまだ抜けていないと判断する
*/
bool wallArmed = true;


/*
  正面が開いている状態が
  何回連続したか
*/
int clearCount = 0;

const int CLEAR_REQUIRED = 3;


/* ==================================================
   左右スキャン結果
   ================================================== */

struct ScanResult {

  float left;
  float right;
};


/* ==================================================
   超音波センサー
   ================================================== */

/* 1回距離を取得 */
float getDistance() {

  digitalWrite(HC_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(HC_TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(HC_TRIG, LOW);


  unsigned long duration =
    pulseIn(HC_ECHO, HIGH, 30000);


  if (duration == 0) {

    return 999.0;
  }


  return duration / 58.0;
}


/*
  3回測定して中央値を使用する

  1回だけ変な値が出ても
  判定に使われにくくする
*/
float getStableDistance() {

  float a = getDistance();

  delay(5);

  float b = getDistance();

  delay(5);

  float c = getDistance();


  if (a > b) {

    float temp = a;

    a = b;

    b = temp;
  }


  if (b > c) {

    float temp = b;

    b = c;

    c = temp;
  }


  if (a > b) {

    float temp = a;

    a = b;

    b = temp;
  }


  return b;
}


/* 指定した方向を見る */
float getDistanceAt(int angle) {

  head.write(angle);

  delay(250);

  return getStableDistance();
}


/*
  左右を確認する
*/
ScanResult scanSides() {

  ScanResult result;


  result.left =
    getDistanceAt(LEFT_ANGLE);


  result.right =
    getDistanceAt(RIGHT_ANGLE);


  /*
    正面へ戻す
  */
  head.write(FRONT_ANGLE);

  delay(150);


  Serial.print("左距離: ");

  Serial.print(result.left);


  Serial.print("  右距離: ");

  Serial.println(result.right);


  return result;
}


/* ==================================================
   赤外線センサー
   ================================================== */

bool checkIR(int pin) {

  /*
    1回目
  */
  if (digitalRead(pin) != IR_ACTIVE) {

    return false;
  }


  delay(15);


  /*
    2回連続して反応していれば有効
  */
  return digitalRead(pin) == IR_ACTIVE;
}


/* ==================================================
   モーター
   ================================================== */

void moveForward() {

  analogWrite(RMO_EA, R_PWM);

  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);


  analogWrite(RMO_EB, L_PWM);

  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);
}


void stopMotor() {

  analogWrite(RMO_EA, 0);

  digitalWrite(RMO_MA1, LOW);
  digitalWrite(RMO_MA2, LOW);


  analogWrite(RMO_EB, 0);

  digitalWrite(RMO_MB1, LOW);
  digitalWrite(RMO_MB2, LOW);
}


/* 左へその場旋回 */
void turnLeft() {

  analogWrite(RMO_EA, R_PWM);

  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);


  analogWrite(RMO_EB, L_PWM);

  digitalWrite(RMO_MB1, LOW);
  digitalWrite(RMO_MB2, HIGH);
}


/* 右へその場旋回 */
void turnRight() {

  analogWrite(RMO_EA, R_PWM);

  digitalWrite(RMO_MA1, LOW);
  digitalWrite(RMO_MA2, HIGH);


  analogWrite(RMO_EB, L_PWM);

  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);
}


/*
  右方向へ少し寄せる

  右輪を遅くするだけで
  逆転はさせない
*/
void adjustRight() {

  analogWrite(
    RMO_EA,
    ADJUST_SLOW_PWM
  );

  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);


  analogWrite(
    RMO_EB,
    ADJUST_FAST_PWM
  );

  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);


  delay(ADJUST_TIME);
}


/*
  左方向へ少し寄せる
*/
void adjustLeft() {

  analogWrite(
    RMO_EA,
    ADJUST_FAST_PWM
  );

  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);


  analogWrite(
    RMO_EB,
    ADJUST_SLOW_PWM
  );

  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);


  delay(ADJUST_TIME);
}


/* ==================================================
   90度旋回
   ================================================== */

void turnLeft90() {

  stopMotor();

  delay(200);


  turnLeft();

  delay(TURN_90_MS);


  stopMotor();

  delay(200);
}


void turnRight90() {

  stopMotor();

  delay(200);


  turnRight();

  delay(TURN_90_MS);


  stopMotor();

  delay(200);
}


/* ==================================================
   状態変更
   ================================================== */

void changeState(
  CourseState nextState
) {

  state = nextState;

  stateStartTime = millis();


  /*
    今見えている壁を
    次の状態で再利用しない
  */
  wallArmed = false;

  clearCount = 0;


  Serial.print("状態変更 -> ");

  Serial.println((int)state);
}


/* ==================================================
   壁判定を再び有効にする
   ================================================== */

void updateWallArm(
  float frontDistance
) {

  if (wallArmed) {

    return;
  }


  /*
    正面が十分開いた
  */
  if (
    frontDistance >
    REARM_DISTANCE
  ) {

    clearCount++;


    /*
      3回連続して開いていれば
      前の壁を完全に抜けたと判断
    */
    if (
      clearCount >=
      CLEAR_REQUIRED
    ) {

      wallArmed = true;

      clearCount = 0;


      Serial.println(
        "次の壁判定を開始"
      );
    }
  }

  else {

    clearCount = 0;
  }
}


/* ==================================================
   正面に何かあるか確認
   ================================================== */

bool frontBlocked(
  float frontDistance,
  float threshold
) {

  /*
    1回目
  */
  if (
    frontDistance <= 0 ||
    frontDistance > threshold
  ) {

    return false;
  }


  /*
    もう一度確認
  */
  delay(20);


  float secondDistance =
    getStableDistance();


  if (
    secondDistance <= 0 ||
    secondDistance > threshold
  ) {

    return false;
  }


  return true;
}


/* ==================================================
   IRによる軽い方向修正
   ================================================== */

bool correctWithIR(
  bool leftIR,
  bool rightIR
) {

  /*
    状態変更直後は
    壁を拾いやすいので無視する
  */
  if (
    millis() - stateStartTime <
    IR_IGNORE_TIME
  ) {

    return false;
  }


  /*
    左だけ反応
  */
  if (
    leftIR &&
    !rightIR
  ) {

    adjustRight();

    return true;
  }


  /*
    右だけ反応
  */
  if (
    rightIR &&
    !leftIR
  ) {

    adjustLeft();

    return true;
  }


  /*
    両方反応している場合は
    IRだけでは判断しない
  */
  return false;
}


/* ==================================================
   正面障害物回避
   ================================================== */

void avoidObstacle(
  ScanResult scan,
  bool leftIR,
  bool rightIR
) {

  /*
    左IRだけ反応しているなら
    右へ避ける
  */
  if (
    leftIR &&
    !rightIR
  ) {

    adjustRight();

    return;
  }


  /*
    右IRだけ反応しているなら
    左へ避ける
  */
  if (
    rightIR &&
    !leftIR
  ) {

    adjustLeft();

    return;
  }


  /*
    IRで判断できなければ
    超音波で広い側へ避ける
  */
  if (
    scan.left >
    scan.right
  ) {

    adjustLeft();
  }

  else {

    adjustRight();
  }
}


/* ==================================================
   Uターン後の向き確認
   ================================================== */

void correctAfterUTurn() {

  /*
    Uターン後にまだ壁を向いていたら
    少しずつ開いている方向へ修正する

    無限ループ防止のため最大4回
  */

  for (
    int i = 0;
    i < 4;
    i++
  ) {

    float front =
      getStableDistance();


    /*
      正面が開いていれば終了
    */
    if (
      front >
      WALL_DISTANCE
    ) {

      return;
    }


    ScanResult scan =
      scanSides();


    /*
      左の方が広い
    */
    if (
      scan.left >
      scan.right
    ) {

      turnLeft();

      delay(
        TURN_90_MS / 3
      );
    }

    else {

      turnRight();

      delay(
        TURN_90_MS / 3
      );
    }


    stopMotor();

    delay(150);
  }
}


/* ==================================================
   Uターン
   ================================================== */

void smartUTurn(
  ScanResult scan
) {

  stopMotor();

  delay(200);


  /*
    左右のうち
    より広い方向へUターンする

    常に右旋回するより
    壁に巻き込まれにくい
  */
  if (
    scan.left >
    scan.right
  ) {

    Serial.println(
      "左方向へUターン"
    );


    turnLeft();
  }

  else {

    Serial.println(
      "右方向へUターン"
    );


    turnRight();
  }


  delay(TURN_180_MS);


  stopMotor();

  delay(200);


  /*
    180度回した結果を
    センサーでも確認する
  */
  correctAfterUTurn();


  /*
    Uターン地点の壁から離れる
  */
  moveForward();

  delay(500);


  stopMotor();

  delay(200);
}


/* ==================================================
   setup
   ================================================== */

void setup() {

  Serial.begin(115200);


  /* 超音波センサー */
  pinMode(
    HC_TRIG,
    OUTPUT
  );

  pinMode(
    HC_ECHO,
    INPUT
  );


  /* 赤外線センサー */
  pinMode(
    IRLED_L,
    INPUT
  );

  pinMode(
    IRLED_R,
    INPUT
  );


  /* モーター */
  pinMode(
    RMO_EA,
    OUTPUT
  );

  pinMode(
    RMO_EB,
    OUTPUT
  );

  pinMode(
    RMO_MA1,
    OUTPUT
  );

  pinMode(
    RMO_MA2,
    OUTPUT
  );

  pinMode(
    RMO_MB1,
    OUTPUT
  );

  pinMode(
    RMO_MB2,
    OUTPUT
  );


  /* サーボ */
  head.attach(
    SERVOPIN,
    500,
    2400
  );


  head.write(
    FRONT_ANGLE
  );


  stopMotor();

  delay(1000);


  stateStartTime =
    millis();
}


/* ==================================================
   loop
   ================================================== */

void loop() {

  /*
    センサーを取得
  */
  float frontDistance =
    getStableDistance();


  bool leftIR =
    checkIR(IRLED_L);


  bool rightIR =
    checkIR(IRLED_R);


  /*
    旋回前の壁を抜けたか確認
  */
  updateWallArm(
    frontDistance
  );


  /* デバッグ表示 */
  Serial.print("状態: ");

  Serial.print(
    (int)state
  );


  Serial.print(
    "  左IR: "
  );

  Serial.print(
    leftIR
  );


  Serial.print(
    "  右IR: "
  );

  Serial.print(
    rightIR
  );


  Serial.print(
    "  正面: "
  );

  Serial.print(
    frontDistance
  );


  Serial.print(
    "  WALL_ARMED: "
  );

  Serial.println(
    wallArmed
  );


  /* ==================================================
     状態遷移
     ================================================== */

  switch (state) {


    /* ==================================================
       往路 横方向
       ================================================== */

    case OUTBOUND_HORIZONTAL:


      /*
        正面に何かある
      */
      if (
        wallArmed &&
        frontBlocked(
          frontDistance,
          WALL_DISTANCE
        )
      ) {

        stopMotor();


        ScanResult scan =
          scanSides();


        /*
          左が開いていて
          右が塞がっている

          コース上の左折地点と判断
        */
        if (
          scan.left >
            SIDE_OPEN_DISTANCE &&
          scan.right <=
            SIDE_OPEN_DISTANCE
        ) {

          Serial.println(
            "左コーナー"
          );


          turnLeft90();


          changeState(
            OUTBOUND_VERTICAL
          );


          break;
        }


        /*
          コーナーの形ではない

          ボトル等の障害物として回避
        */
        avoidObstacle(
          scan,
          leftIR,
          rightIR
        );


        break;
      }


      /*
        横から物体に近づいた場合
      */
      if (
        correctWithIR(
          leftIR,
          rightIR
        )
      ) {

        break;
      }


      moveForward();

      break;



    /* ==================================================
       往路 縦方向
       ================================================== */

    case OUTBOUND_VERTICAL:


      /*
        Uターン地点の壁
      */
      if (
        wallArmed &&
        frontBlocked(
          frontDistance,
          WALL_DISTANCE
        )
      ) {

        stopMotor();


        ScanResult scan =
          scanSides();


        /*
          左右とも完全に開いている場合は
          壁よりもボトルの可能性が高い
        */
        bool narrowObject =
          scan.left >
            SIDE_OPEN_DISTANCE &&
          scan.right >
            SIDE_OPEN_DISTANCE;


        if (narrowObject) {

          Serial.println(
            "正面障害物"
          );


          avoidObstacle(
            scan,
            leftIR,
            rightIR
          );


          break;
        }


        /*
          正面 + 左右どちらかに
          壁が続いているので
          コース終端と判断
        */
        Serial.println(
          "Uターン地点"
        );


        smartUTurn(
          scan
        );


        changeState(
          RETURN_VERTICAL
        );


        break;
      }


      if (
        correctWithIR(
          leftIR,
          rightIR
        )
      ) {

        break;
      }


      moveForward();

      break;



    /* ==================================================
       復路 縦方向
       ================================================== */

    case RETURN_VERTICAL:


      if (
        wallArmed &&
        frontBlocked(
          frontDistance,
          WALL_DISTANCE
        )
      ) {

        stopMotor();


        ScanResult scan =
          scanSides();


        /*
          右が開いていて
          左に壁がある

          帰りの右折地点
        */
        if (
          scan.right >
            SIDE_OPEN_DISTANCE &&
          scan.left <=
            SIDE_OPEN_DISTANCE
        ) {

          Serial.println(
            "右コーナー"
          );


          turnRight90();


          changeState(
            RETURN_HORIZONTAL
          );


          break;
        }


        /*
          コーナーでなければ
          障害物として回避
        */
        avoidObstacle(
          scan,
          leftIR,
          rightIR
        );


        break;
      }


      if (
        correctWithIR(
          leftIR,
          rightIR
        )
      ) {

        break;
      }


      moveForward();

      break;



    /* ==================================================
       復路 横方向
       ================================================== */

    case RETURN_HORIZONTAL:


      /*
        ゴールでは壁の種類を
        判断する必要がない

        5cm以内が2回確認されたら停止
      */
      if (
        frontDistance > 0 &&
        frontDistance <=
          GOAL_DISTANCE
      ) {

        delay(20);


        float confirmDistance =
          getStableDistance();


        if (
          confirmDistance > 0 &&
          confirmDistance <=
            GOAL_DISTANCE
        ) {

          stopMotor();


          state = GOAL;


          Serial.println(
            "GOAL"
          );


          break;
        }
      }


      if (
        correctWithIR(
          leftIR,
          rightIR
        )
      ) {

        break;
      }


      moveForward();

      break;



    /* ==================================================
       ゴール
       ================================================== */

    case GOAL:


      stopMotor();

      break;
  }


  delay(20);
}
