#include <Servo.h>

/* 超音波センサー */
#define SERVOPIN  9
#define HC_ECHO   2
#define HC_TRIG   10

/* 赤外線センサー */
#define IRLED_L   4
#define IRLED_R   5

/* モーター */
#define RMO_EA    3
#define RMO_EB    6
#define RMO_MB1   7
#define RMO_MB2   8
#define RMO_MA2   11
#define RMO_MA1   12

Servo head;

/* モーターのPWM */
const int L_PWM = 140;
const int R_PWM = 140;

/* 進行方向を修正するときのPWM */
const int L_ADJUST_PWM = 140;
const int R_ADJUST_PWM = 140;

/* 壁との距離 */
const float WALL_DISTANCE = 20.0;
const float GOAL_DISTANCE = 5.0;

/* 左右を見たとき壁と判断する距離 */
const float WIDE_WALL_DISTANCE = 15.0;

/* サーボモーターの角度 */
const int FRONT_ANGLE = 90;
const int LEFT_ANGLE = 140;
const int RIGHT_ANGLE = 45;

/* 旋回時間 */
const int TURN_90_MS = 350;
const int TURN_180_MS = 700;

/* 進行方向を修正する時間 */
const int ADJUST_TIME = 150;

/* 赤外線センサーの反応 */
const int IR_ACTIVE = LOW;


/* 状態管理 */
enum CourseState {
  OUTBOUND_HORIZONTAL,
  OUTBOUND_VERTICAL,
  RETURN_VERTICAL,
  RETURN_HORIZONTAL,
  GOAL
};

CourseState state = OUTBOUND_HORIZONTAL;


/* 正面を確認した結果 */
enum FrontResult {
  FRONT_CLEAR,
  FRONT_WALL,
  FRONT_ADJUST_LEFT,
  FRONT_ADJUST_RIGHT
};


/* 超音波センサーで距離を求める */
float getDistance() {
  digitalWrite(HC_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(HC_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(HC_TRIG, LOW);

  unsigned long duration = pulseIn(HC_ECHO, HIGH, 30000);

  if (duration == 0) {
    return 999.0;
  }

  return duration / 58.0;
}


/* 超音波センサーの角度を変えて距離を求める */
float getDistanceAt(int angle) {
  head.write(angle);
  delay(300);

  return getDistance();
}


/* 赤外線センサーを確認 */
bool checkIR(int pin) {
  if (digitalRead(pin) == IR_ACTIVE) {
    delay(20);

    if (digitalRead(pin) == IR_ACTIVE) {
      return true;
    }
  }

  return false;
}


/* 前進 */
void moveForward() {
  analogWrite(RMO_EA, R_PWM);
  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);

  analogWrite(RMO_EB, L_PWM);
  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);
}


/* 停止 */
void stopMotor() {
  analogWrite(RMO_EA, 0);
  digitalWrite(RMO_MA1, LOW);
  digitalWrite(RMO_MA2, LOW);

  analogWrite(RMO_EB, 0);
  digitalWrite(RMO_MB1, LOW);
  digitalWrite(RMO_MB2, LOW);
}


/* 左折 */
void turnLeft() {
  analogWrite(RMO_EA, R_PWM);
  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);

  analogWrite(RMO_EB, L_PWM);
  digitalWrite(RMO_MB1, LOW);
  digitalWrite(RMO_MB2, HIGH);
}


/* 右折 */
void turnRight() {
  analogWrite(RMO_EA, R_PWM);
  digitalWrite(RMO_MA1, LOW);
  digitalWrite(RMO_MA2, HIGH);

  analogWrite(RMO_EB, L_PWM);
  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);
}


/* 少し右へ進む */
void adjustRight() {
  analogWrite(RMO_EA, R_ADJUST_PWM);
  digitalWrite(RMO_MA1, LOW);
  digitalWrite(RMO_MA2, HIGH);

  analogWrite(RMO_EB, L_PWM);
  digitalWrite(RMO_MB1, HIGH);
  digitalWrite(RMO_MB2, LOW);

  delay(ADJUST_TIME);
}


/* 少し左へ進む */
void adjustLeft() {
  analogWrite(RMO_EA, R_PWM);
  digitalWrite(RMO_MA1, HIGH);
  digitalWrite(RMO_MA2, LOW);

  analogWrite(RMO_EB, L_ADJUST_PWM);
  digitalWrite(RMO_MB1, LOW);
  digitalWrite(RMO_MB2, HIGH);

  delay(ADJUST_TIME);
}


/* 左へ90度 */
void turnLeft90() {
  stopMotor();
  delay(200);

  turnLeft();
  delay(TURN_90_MS);

  stopMotor();
  delay(200);
}


/* 右へ90度 */
void turnRight90() {
  stopMotor();
  delay(200);

  turnRight();
  delay(TURN_90_MS);

  stopMotor();
  delay(200);
}


/* Uターン */
void uTurn() {
  stopMotor();
  delay(200);

  turnRight();
  delay(2160);

  stopMotor();
  delay(200);

  moveForward();
  delay(500);

  stopMotor();
  delay(200);

}


/* 正面にあるものを確認 */
FrontResult checkFront(float frontDistance, float threshold,
                       bool leftIR, bool rightIR) {

  /* 正面に何もない */
  if (frontDistance <= 0 || frontDistance > threshold) {
    return FRONT_CLEAR;
  }

  /* もう一度測定 */
  delay(20);
  float frontDistance2 = getDistance();

  if (frontDistance2 <= 0 || frontDistance2 > threshold) {
    return FRONT_CLEAR;
  }

  stopMotor();
  delay(100);

  /* 左右の距離を確認 */
  float leftDistance = getDistanceAt(LEFT_ANGLE);
  float rightDistance = getDistanceAt(RIGHT_ANGLE);

  /* 正面に戻す */
  head.write(FRONT_ANGLE);
  delay(200);

  Serial.print("左距離: ");
  Serial.println(leftDistance);
  Serial.print("右距離: ");
  Serial.println(rightDistance);

  /*
     左右にも壁がある場合は
     正面の広い壁と判断
  */
  if (leftDistance <= WIDE_WALL_DISTANCE &&
      rightDistance <= WIDE_WALL_DISTANCE) {
    return FRONT_WALL;
  }

  /*
     赤外線センサーが反応している場合は
     反応した方向と逆へ進む
  */
  if (leftIR && !rightIR) {
    return FRONT_ADJUST_RIGHT;
  }

  if (rightIR && !leftIR) {
    return FRONT_ADJUST_LEFT;
  }

  /*
     正面に物があるが広い壁ではない場合は
     距離が長い方へ避ける
  */
  if (leftDistance > rightDistance) {
    return FRONT_ADJUST_LEFT;
  } else {
    return FRONT_ADJUST_RIGHT;
  }
}


void setup() {
  Serial.begin(115200);

  /* 超音波センサー */
  pinMode(HC_TRIG, OUTPUT);
  pinMode(HC_ECHO, INPUT);

  /* 赤外線センサー */
  pinMode(IRLED_L, INPUT);
  pinMode(IRLED_R, INPUT);

  /* モーター */
  pinMode(RMO_EA, OUTPUT);
  pinMode(RMO_EB, OUTPUT);
  pinMode(RMO_MA1, OUTPUT);
  pinMode(RMO_MA2, OUTPUT);
  pinMode(RMO_MB1, OUTPUT);
  pinMode(RMO_MB2, OUTPUT);

  /* サーボモーター */
  head.attach(SERVOPIN, 500, 2400);
  head.write(FRONT_ANGLE);

  stopMotor();
  delay(1000);
}


void loop() {
  float frontDistance = getDistance();

  bool leftIR = checkIR(IRLED_L);
  bool rightIR = checkIR(IRLED_R);

  /* センサーの値を表示 */
  Serial.print("状態: ");
  Serial.println(state);

  Serial.print("左IR: ");
  Serial.println(leftIR);

  Serial.print("右IR: ");
  Serial.println(rightIR);

  Serial.print("正面: ");
  Serial.println(frontDistance);

  FrontResult frontResult;

  switch (state) {

    /* 往路 */
    case OUTBOUND_HORIZONTAL:

      frontResult = checkFront(
        frontDistance,
        WALL_DISTANCE,
        leftIR,
        rightIR
      );

      if (frontResult == FRONT_WALL) {
        moveForward();
        delay(400);
        turnLeft90();
        state = OUTBOUND_VERTICAL;
        break;
      }

      if (frontResult == FRONT_ADJUST_RIGHT) {
        adjustRight();
        break;
      }

      if (frontResult == FRONT_ADJUST_LEFT) {
        adjustLeft();
        break;
      }

      if (leftIR && !rightIR) {
        adjustRight();
        break;
      }

      if (rightIR && !leftIR) {
        adjustLeft();
        break;
      }

      moveForward();
      break;


  
    case OUTBOUND_VERTICAL:

      frontResult = checkFront(
        frontDistance,
        WALL_DISTANCE,
        leftIR,
        rightIR
      );

      if (frontResult == FRONT_WALL) {
        moveForward();
        delay(200);
        uTurn();
        state = RETURN_VERTICAL;
        break;
      }


      if (leftIR && !rightIR) {
        adjustRight();
        break;
      }

      if (rightIR && !leftIR) {
        adjustLeft();
        break;
      }

      moveForward();
      break;



    /* 復路　*/
    case RETURN_VERTICAL:

      frontResult = checkFront(
        frontDistance,
        WALL_DISTANCE,
        leftIR,
        rightIR
      );

      if (frontResult == FRONT_WALL) {
        turnRight90();
        state = RETURN_HORIZONTAL;
        break;
      }

      if (frontResult == FRONT_ADJUST_RIGHT) {
        adjustRight();
        break;
      }

      if (frontResult == FRONT_ADJUST_LEFT) {
        adjustLeft();
        break;
      }

      if (leftIR && !rightIR) {
        adjustRight();
        break;
      }

      if (rightIR && !leftIR) {
        adjustLeft();
        break;
      }

      moveForward();
      break;

    case RETURN_HORIZONTAL:

      frontResult = checkFront(
        frontDistance,
        GOAL_DISTANCE,
        leftIR,
        rightIR
      );

      if (frontResult == FRONT_WALL) {
        stopMotor();
        state = GOAL;
        break;
      }

      if (frontResult == FRONT_ADJUST_RIGHT) {
        adjustRight();
        break;
      }

      if (frontResult == FRONT_ADJUST_LEFT) {
        adjustLeft();
        break;
      }

      if (leftIR && !rightIR) {
        adjustRight();
        break;
      }

      if (rightIR && !leftIR) {
        adjustLeft();
        break;
      }

      moveForward();
      break;


    /* ゴール */
    case GOAL:
      stopMotor();
      break;
  }

  delay(20);
}
